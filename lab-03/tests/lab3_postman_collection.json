{
  "info": {
    "_postman_id": "bdf-lab-03-collection-books-api",
    "name": "BDF Lab 03 - Books REST API Test Suite",
    "description": "Comprehensive Postman test collection for BDF Lab 3 covering RESTful CRUD, query parameters, sorting, pagination, filtering, input validation, status codes, and error formatting.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "createdBookId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Success Scenarios",
      "item": [
        {
          "name": "GET /books (Default params)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is an array\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(Array.isArray(jsonData)).to.be.true;",
                  "    pm.expect(jsonData.length).to.be.at.least(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /books?search_q=Clean (Title Search with LIKE)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?search_q=Clean",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "search_q", "value": "Clean" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"All returned books contain search keyword in title\", function () {",
                  "    const books = pm.response.json();",
                  "    pm.expect(books.length).to.be.greaterThan(0);",
                  "    books.forEach(b => pm.expect(b.title.toLowerCase()).to.include('clean'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /books with Price Filter (min_price & max_price)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?min_price=40&max_price=50",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "min_price", "value": "40" },
                { "key": "max_price", "value": "50" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Prices fall within specified range [40, 50]\", function () {",
                  "    const books = pm.response.json();",
                  "    books.forEach(b => {",
                  "        pm.expect(b.price).to.be.at.least(40);",
                  "        pm.expect(b.price).to.be.at.most(50);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /books with Sorting & Pagination (order_by, order, limit, offset)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?order_by=price&order=DESC&limit=3&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "order_by", "value": "price" },
                { "key": "order", "value": "DESC" },
                { "key": "limit", "value": "3" },
                { "key": "offset", "value": "0" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Respects limit of 3\", function () {",
                  "    const books = pm.response.json();",
                  "    pm.expect(books.length).to.be.at.most(3);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /books (Create Book)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Database System Concepts\",\n  \"author\": \"Silberschatz, Korth, Sudarshan\",\n  \"price\": 65.50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Returns created book with generated ID\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.book).to.have.property('id');",
                  "    pm.expect(res.book.title).to.eql(\"Database System Concepts\");",
                  "    pm.collectionVariables.set(\"createdBookId\", res.book.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /books/:id (Retrieve Single Book)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{createdBookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{createdBookId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns correct book record\", function () {",
                  "    const book = pm.response.json();",
                  "    pm.expect(String(book.id)).to.eql(String(pm.collectionVariables.get(\"createdBookId\")));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PUT /books/:id (Update Existing Book)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Database System Concepts (7th Edition)\",\n  \"author\": \"Silberschatz, Korth, Sudarshan\",\n  \"price\": 72.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books/{{createdBookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{createdBookId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Updated book reflects changes\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.book.price).to.eql(72.00);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "DELETE /books/:id (Delete Book)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{createdBookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{createdBookId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has success message\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.message).to.include(\"deleted successfully\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Failure & Validation Scenarios",
      "item": [
        {
          "name": "POST /books (Missing Title -> 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author\": \"Author without Title\",\n  \"price\": 20.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Returns descriptive error message\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res).to.have.property('message');",
                  "    pm.expect(res.message.toLowerCase()).to.include('title');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /books (Missing Author -> 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Title without Author\",\n  \"price\": 20.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Returns descriptive error message\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.message.toLowerCase()).to.include('author');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /books (Non-numeric Price -> 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Book with Invalid Price\",\n  \"author\": \"Valid Author\",\n  \"price\": \"free_of_cost\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Returns descriptive error message\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.message.toLowerCase()).to.include('price');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /books/:id (Non-existent ID -> 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/99999",
              "host": ["{{baseUrl}}"],
              "path": ["books", "99999"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test(\"Returns structured error message\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res).to.have.property('message');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PUT /books/:id (Non-existent ID -> 404)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Non Existent\",\n  \"author\": \"Nobody\",\n  \"price\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books/99999",
              "host": ["{{baseUrl}}"],
              "path": ["books", "99999"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "DELETE /books/:id (Non-existent ID -> 404)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/99999",
              "host": ["{{baseUrl}}"],
              "path": ["books", "99999"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /books (Invalid order_by Column -> 400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?order_by=invalid_column",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "order_by", "value": "invalid_column" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Returns error message explaining allowed sort columns\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.message).to.include('order_by');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}

